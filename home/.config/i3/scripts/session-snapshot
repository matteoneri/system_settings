#!/bin/bash
# Snapshot the i3 session (layout, focus, terminal cwds, agent sessions) on an interval.
# Also keeps a user-named Claude Code session's name in its kitty title.
# Started once from i3 config (exec --no-startup-id).

STATE_DIR="$HOME/.config/i3-session"
SNAPSHOT="$STATE_DIR/snapshot.json"
PIDFILE="$STATE_DIR/snapshot.pid"
RESTORE_LOCK="$STATE_DIR/restore.lock"
RESTORE_DONE="/tmp/i3-session-restore-done"
INTERVAL=30
TITLE_POLL=3
LOCK_STALE=300
FIRST_TICK_WAIT=180
TITLE_VAR="I3SESSION_TITLE"
TITLE_MAX=80

ONCE=""
[[ "$1" == "--once" ]] && ONCE=1

mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"

# Single instance: a live pid in the pidfile wins. --once is a manual check and
# does not claim the pidfile, so it can run alongside the watcher.
if [[ -z "$ONCE" ]]; then
    # kill -0 alone would trust a recycled pid belonging to something else, so
    # confirm the process is this script before yielding to it.
    running_pid=$(cat "$PIDFILE" 2>/dev/null)
    if [[ -n "$running_pid" ]] && kill -0 "$running_pid" 2>/dev/null \
        && tr '\0' ' ' < "/proc/$running_pid/cmdline" 2>/dev/null | rg -q "session-snapshot"; then
        exit 0
    fi
    echo $$ > "$PIDFILE"
    trap 'rm -f "$PIDFILE"' EXIT
fi

# --- kitty enumeration -------------------------------------------------------

# One JSON object per kitty OS window, keyed later by its X11 window id.
kitty_windows() {
    local pid sock
    for pid in $(pgrep -x -u "$UID" kitty); do
        sock="unix:@kitty-$pid"
        kitty @ --to "$sock" ls 2>/dev/null | jq -c --arg sock "$sock" '
            # One entry per OS window, because that is what i3 sees and what
            # platform_window_id identifies. A window with several tabs or splits
            # would otherwise emit siblings sharing that id, and keying a map by
            # it would silently keep whichever pane came last. Take the focused
            # pane of the focused tab, falling back to the first of each.
            .[] as $ow
            | ((($ow.tabs // []) | map(select(.is_focused)) + $ow.tabs) | .[0]) as $tab
            | (((($tab.windows // []) | map(select(.is_focused))) + ($tab.windows // [])) | .[0]) as $w
            | select($w != null)
            | {
                win_id: $ow.platform_window_id,
                sock: $sock,
                kitty_win: $w.id,
                shell: $w.pid,
                cwd: $w.cwd,
                user_vars: ($w.user_vars // {}),
                fg: [ $w.foreground_processes[]? | { pid: .pid, cmd: (.cmdline[0] // "") } ]
            }' 2>/dev/null
    done
}

# --- agent identity ----------------------------------------------------------

# Kernel start time of a pid, used to reject a session record whose pid was reused.
proc_start() {
    awk '{print $22}' "/proc/$1/stat" 2>/dev/null
}

env_value() {
    tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | sed -n "s/^$2=//p" | head -1
}

# Newest recorded session for a cwd under one account. Fallback only; inexact.
newest_session_for() {
    local config_dir="$1" cwd="$2" slug
    # Both separators become dashes: /home/x/.worktrees/y -> -home-x--worktrees-y
    slug="${cwd//\//-}"
    slug="${slug//./-}"
    fd -e jsonl . "$config_dir/projects/$slug" 2>/dev/null \
        | xargs -r ls -t 2>/dev/null | head -1 | xargs -r basename | sed 's/\.jsonl$//'
}

# These emit a JSON object rather than delimited fields: tab is IFS whitespace,
# so bash read collapses consecutive tabs and empty fields would shift.
agent_json() {
    jq -cn --arg agent "$1" --arg sid "$2" --arg cdir "$3" --argjson inexact "$4" \
        '{ agent: (if $agent == "" then null else $agent end),
           session_id: (if $sid == "" then null else $sid end),
           config_dir: (if $cdir == "" then null else $cdir end),
           inexact: $inexact }'
}

resolve_claude() {
    local pid="$1" cwd="$2" config_dir record sid rec_start live_start
    config_dir=$(env_value "$pid" CLAUDE_CONFIG_DIR)
    [[ -z "$config_dir" ]] && config_dir="$HOME/.claude"
    record="$config_dir/sessions/$pid.json"
    if [[ -r "$record" ]]; then
        rec_start=$(jq -r '.procStart // empty' "$record")
        live_start=$(proc_start "$pid")
        sid=$(jq -r '.sessionId // empty' "$record")
        # procStart must match the live process, or the record is a reused pid.
        if [[ -n "$sid" && -n "$rec_start" && "$rec_start" == "$live_start" ]]; then
            agent_json claude "$sid" "$config_dir" false
            return
        fi
    fi
    sid=$(newest_session_for "$config_dir" "$cwd")
    agent_json claude "$sid" "$config_dir" true
}

# The top-level codex session is the open rollout whose own header says source=cli;
# the others the process holds open are subagent threads.
resolve_codex() {
    local pid="$1" link f sid
    for link in /proc/"$pid"/fd/*; do
        f=$(readlink "$link" 2>/dev/null)
        case "$f" in
            "$HOME"/.codex/sessions/*rollout-*.jsonl) ;;
            *) continue ;;
        esac
        sid=$(head -1 "$f" 2>/dev/null | jq -r 'select(.payload.source == "cli") | .payload.id // empty' 2>/dev/null)
        if [[ -n "$sid" ]]; then
            agent_json codex "$sid" "" false
            return
        fi
    done
    agent_json codex "" "" true
}

# Resolve whichever agent is in a window's foreground process list.
resolve_agent() {
    local cwd="$1" pid cmd base
    shift
    while [[ $# -gt 1 ]]; do
        pid="$1"; cmd="$2"; shift 2
        base="${cmd##*/}"
        case "$base" in
            claude) resolve_claude "$pid" "$cwd"; return ;;
            codex)  resolve_codex "$pid"; return ;;
        esac
    done
    agent_json "" "" "" false
}

# --- title override ----------------------------------------------------------

sanitize_title() {
    tr -d '\000-\037\177' | cut -c1-"$TITLE_MAX"
}

# Names the user chose, mapped to the terminal they belong to.
#
# A record is keyed by the pid that owns the session, and an interactive session
# spawns background agents whose records sit under a daemon several levels down.
# The name the user sees in a window can therefore live on a descendant's
# record, not on the window's own foreground process — so attribute every record
# to each of its ancestors and let the window pick the newest match. A record
# carrying nameSource was named by the CLI, not the user, and is skipped.
owned_names() {
    local -A parent=()
    local pid ppid f rp name upd anc i
    while read -r pid ppid; do parent[$pid]=$ppid; done < <(ps -eo pid=,ppid=)
    for f in "$HOME"/.claude-*/sessions/*.json; do
        [[ -e "$f" ]] || continue
        jq -e 'has("nameSource") | not' "$f" >/dev/null 2>&1 || continue
        read -r rp upd name < <(jq -r '[(.pid|tostring), ((.updatedAt // 0)|tostring), (.name // "")] | @tsv' "$f" | sed 's/\t/ /; s/\t/ /')
        [[ -z "$name" || -z "$rp" ]] && continue
        anc="$rp"
        for ((i = 0; i < 14; i++)); do
            [[ -z "$anc" || "$anc" == "1" ]] && break
            jq -cn --argjson s "$anc" --argjson u "${upd:-0}" --arg n "$name" '{shell:$s, updated:$u, name:$n}'
            anc="${parent[$anc]}"
        done
    done
}

# Newest user-chosen name belonging to the terminal whose shell is $1.
name_for_shell() {
    jq -rs --argjson s "$1" 'map(select(.shell == $s)) | sort_by(.updated) | last | .name // empty' <<< "$2"
}

apply_titles() {
    local windows="$1" names w sock kitty_win owned shell has_claude name applied
    names=$(owned_names)
    # One JSON object per line, fields read individually — a delimited format
    # would collapse empty fields (tab is IFS whitespace) and shift them.
    while IFS= read -r w; do
        [[ -z "$w" ]] && continue
        sock=$(jq -r '.sock' <<< "$w")
        kitty_win=$(jq -r '.kitty_win' <<< "$w")
        owned=$(jq -r '.owned // ""' <<< "$w")
        shell=$(jq -r '.shell // 0' <<< "$w")
        has_claude=$(jq -r '.has_claude' <<< "$w")
        [[ -z "$sock" ]] && continue
        applied=""
        if [[ "$has_claude" == "true" ]]; then
            name=$(name_for_shell "$shell" "$names" | sanitize_title)
            if [[ -n "$name" ]]; then
                if [[ "$owned" != "$name" ]]; then
                    kitty @ --to "$sock" set-window-title --match "id:$kitty_win" "$name" 2>/dev/null
                    kitty @ --to "$sock" set-user-vars --match "id:$kitty_win" "$TITLE_VAR=$name" 2>/dev/null
                fi
                applied=1
            fi
        fi
        # We set this title once and the session is gone or no longer named by
        # the user: hand the title back to the program running in the window.
        if [[ -z "$applied" && -n "$owned" ]]; then
            kitty @ --to "$sock" set-window-title --match "id:$kitty_win" --temporary 2>/dev/null
            kitty @ --to "$sock" set-user-vars --match "id:$kitty_win" "$TITLE_VAR" 2>/dev/null
        fi
    done <<< "$windows"
}

# Fingerprint of just the name fields across all session records. A rename
# changes this; the constant status/updatedAt churn does not, so the kitty work
# below runs on an actual rename rather than every few seconds.
names_fingerprint() {
    jq -rs 'map((.pid|tostring) + ":" + (.name // "") + ":" + (.nameSource // "")) | sort | join(",")' \
        "$HOME"/.claude-*/sessions/*.json 2>/dev/null
}

# The title half of a tick: cheap enough to run on every rename.
title_pass() {
    local kitty_meta
    kitty_meta=$(kitty_windows | jq -c --arg v "$TITLE_VAR" \
        '{ sock: .sock, kitty_win: .kitty_win, owned: (.user_vars[$v] // ""),
           shell: (.shell // 0),
           has_claude: (((.fg // []) | map(.cmd | split("/") | last) | index("claude")) != null) }' 2>/dev/null)
    [[ -n "$kitty_meta" ]] && apply_titles "$kitty_meta"
}

# --- snapshot ---------------------------------------------------------------

write_snapshot() {
    local kitty_json tree_json map_json out tmp
    kitty_json=$(kitty_windows | jq -s '.')
    if [[ -z "$kitty_json" || "$kitty_json" == "[]" ]]; then
        notify-send "Session snapshot" "No kitty window responded; check allow_remote_control"
        return 1
    fi

    # Resolve agent identity per kitty window, then key the result by X11 window id.
    map_json=$(
        echo "$kitty_json" | jq -c '.[]' | while read -r w; do
            win_cwd=$(echo "$w" | jq -r '.cwd')
            mapfile -t pairs < <(echo "$w" | jq -r '.fg[]? | .pid, .cmd')
            agent_info=$(resolve_agent "$win_cwd" "${pairs[@]}")
            echo "$w" | jq -c --argjson agent "$agent_info" \
                '{ key: (.win_id|tostring),
                   value: ({ cwd: .cwd, sock: .sock, kitty_win: .kitty_win } + $agent) }'
        done | jq -s 'from_entries'
    )

    tree_json=$(i3-msg -t get_tree 2>/dev/null)
    [[ -z "$tree_json" ]] && return 1

    out=$(echo "$tree_json" | jq \
        --argjson kitty "$map_json" \
        --arg focused "$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused) | .name')" '
        def to_snap:
            if .window != null then
                ((.window_properties.class // "") as $cls |
                 # Only a default-class kitty is ours to relaunch. Every scratchpad
                 # here sets its own --class (dropdown-terminal, dropdown-newsboat,
                 # slovodnia), so this covers them and any future one without a
                 # list to keep in step; other apps keep their declarative placement.
                 if $cls != "kitty" then
                     { type: "leaf", percent: (.percent // 0), restore: false }
                 else
                     ($kitty[(.window|tostring)] // {}) as $kw |
                     { type: "leaf", percent: (.percent // 0),
                       restore: ($kw.cwd != null),
                       cwd: ($kw.cwd // null), agent: ($kw.agent // null),
                       session_id: ($kw.session_id // null),
                       config_dir: ($kw.config_dir // null),
                       inexact: ($kw.inexact // false) }
                 end)
            else
                ({ type: "con", layout: .layout, percent: (.percent // 0),
                   nodes: [ .nodes[]? | to_snap ] | map(select(. != null)) }
                 | if (.nodes | length) == 0 then null else . end)
            end;
        {
            version: 1,
            focused_workspace: $focused,
            workspaces: [
                .. | objects
                | select(.type == "workspace" and (.name | startswith("__i3") | not))
                | { name: .name, tree: [ .nodes[]? | to_snap ] | map(select(. != null)) }
                | select((.tree | length) > 0)
            ]
        }')

    [[ -z "$out" ]] && return 1
    tmp="$SNAPSHOT.tmp.$$"
    ( umask 077; printf '%s\n' "$out" > "$tmp" ) && mv -f "$tmp" "$SNAPSHOT"
}

restore_in_progress() {
    [[ -f "$RESTORE_LOCK" ]] || return 1
    local age
    age=$(( $(date +%s) - $(stat -c %Y "$RESTORE_LOCK" 2>/dev/null || echo 0) ))
    (( age < LOCK_STALE ))
}

tick() {
    restore_in_progress && return 0
    title_pass
    write_snapshot
}

if [[ -n "$ONCE" ]]; then
    tick
    exit $?
fi

# Both scripts autostart together. Take no snapshot until the restore has
# finished, skipped, or found nothing — otherwise the first tick replaces the
# snapshot it was supposed to bring back. The marker is on tmpfs, so a boot
# where the restore never runs at all only costs this bounded wait.
waited=0
while [[ ! -e "$RESTORE_DONE" ]] && (( waited < FIRST_TICK_WAIT )); do
    sleep 2
    waited=$((waited + 2))
done

last_names=""
next_snapshot=0
while true; do
    if ! restore_in_progress; then
        # Titles follow a rename within TITLE_POLL; the snapshot keeps its own,
        # slower cadence because capturing the whole tree is the expensive half.
        names=$(names_fingerprint)
        if [[ "$names" != "$last_names" ]]; then
            title_pass
            last_names="$names"
        fi
        if (( $(date +%s) >= next_snapshot )); then
            # tick() re-runs the title pass as well, so a title lost to another
            # writer heals on this cadence even though no name changed.
            tick
            next_snapshot=$(( $(date +%s) + INTERVAL ))
        fi
    fi
    sleep "$TITLE_POLL"
done
