#!/bin/bash

# Polybar ETH/USD module. Fetches the price with 24h change from CoinGecko,
# caching the rendered line so data saving mode can serve the last value instead
# of fetching every 60s.
#
# The cache never lands in a shared directory. polybar parses click-action tags
# in a module's output and this script prints the cached file verbatim, so a file
# another uid could pre-create or symlink would be both a command-injection and a
# file-clobbering vector. With no runtime directory, use a 0700 uid-scoped one.

DATASAVE_STATUS="${DATASAVE_STATUS:-$HOME/.config/i3/scripts/datasave-status}"
if [ -n "${ETH_PRICE_CACHE:-}" ]; then
    CACHE_FILE="$ETH_PRICE_CACHE"
elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    CACHE_FILE="$XDG_RUNTIME_DIR/polybar-eth-price-cache"
else
    _eth_dir="${TMPDIR:-/tmp}/polybar-$(id -u)"
    mkdir -m 0700 -p "$_eth_dir" 2>/dev/null
    CACHE_FILE="$_eth_dir/eth-price-cache"
fi
PLACEHOLDER=$'\ued58 --'

# Data saving mode: serve the last rendered value and make no network call. With
# no cache yet, fall back to the same placeholder a failed fetch prints, so the
# module keeps rendering rather than vanishing from the bar.
if "$DATASAVE_STATUS" is-on 2>/dev/null; then
    if [ -s "$CACHE_FILE" ]; then
        # No per-module staleness marker: the data saving indicator beside the
        # battery already says every network-backed module is frozen, and
        # repeating that glyph here just clutters the bar.
        cat "$CACHE_FILE"
    else
        echo "$PLACEHOLDER"
    fi
    exit 0
fi

# Fetch ETH/USD price with 24h change from CoinGecko API
data=$(curl -sf --max-time 5 \
  'https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd&include_24hr_change=true')

if [ $? -ne 0 ] || [ -z "$data" ]; then
    echo "$PLACEHOLDER"
    exit 0
fi

price=$(echo "$data" | jq -r '.ethereum.usd')
change=$(echo "$data" | jq -r '.ethereum.usd_24h_change')

# Format price (no decimals above 1000, 2 decimals below)
formatted_price=$(awk -v p="$price" 'BEGIN {
    if (p >= 1000) printf "%.0f", p
    else printf "%.2f", p
}')

# Format change percentage
formatted_change=$(awk -v c="$change" 'BEGIN { printf "%+.1f", c }')

# Color based on 24h change
if (( $(awk -v c="$change" 'BEGIN { print (c >= 0) }') )); then
    color="#5eeaa0"
else
    color="#f45070"
fi

rendered="%{F$color}$(printf '\ued58') $formatted_price (${formatted_change}%)%{F-}"
printf '%s\n' "$rendered" | tee "$CACHE_FILE"
