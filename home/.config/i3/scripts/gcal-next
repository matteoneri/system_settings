#!/bin/bash
# Polybar interval script for Google Calendar events
# Runs once per invocation: refreshes cache if stale, prints next event with color states

CACHE_FILE="${GCAL_CACHE_FILE:-/tmp/polybar-gcal-cache}"
FORCE_FILE="/tmp/polybar-gcal-force"
ALERT_DIR="/tmp/polybar-gcal-alerts"
MAX_TITLE_LEN=30
CACHE_MAX_AGE=600  # 10 minutes
WARN_MINUTES=10
ALERT_MINUTES=5

mkdir -p "$ALERT_DIR"

COLOR_WARN="#FF7043"
COLOR_LIVE="#f45070"

# Icons (font 2)
ICON_NORMAL="%{T2}󰃰%{T-}"
ICON_LIVE="%{T2}󰕧%{T-}"
ICON_PAUSED="%{T2}󰅤%{T-}"  # nf-md-cloud_off_outline — data saving mode is on

DATASAVE_STATUS="${DATASAVE_STATUS:-$HOME/.config/i3/scripts/datasave-status}"
# Resolved once: polybar re-execs this script every 30s, and the mode cannot
# change during one short invocation, so asking more than once only forks again.
DATASAVE_ON=0
"$DATASAVE_STATUS" is-on 2>/dev/null && DATASAVE_ON=1
datasave_on() { (( DATASAVE_ON )); }

GCALCLI="${GCALCLI:-$(command -v gcalcli 2>/dev/null || echo "$HOME/.pyenv/versions/3.12.3/bin/gcalcli")}"
# Exiting empty would hide the module from the bar entirely; print the marker
# instead. This path is live: the fallback is a pinned pyenv path, which breaks
# on an Arch Python major bump.
if [[ ! -x "$GCALCLI" ]]; then
    datasave_on && echo "$ICON_PAUSED" || echo "$ICON_NORMAL"
    exit 0
fi

# User config: defines GCAL_CAL_ARGS as a bash array of --cal entries.
# See ~/Documents/Projects/system_settings/home/.config/gcal-next.env.example
GCAL_CAL_ARGS=()
if [[ -f "$HOME/.config/gcal-next.env" ]]; then
    # shellcheck source=/dev/null
    source "$HOME/.config/gcal-next.env"
fi

time_to_min() {
    local h=${1%%:*} m=${1##*:}
    echo $(( 10#$h * 60 + 10#$m ))
}

refresh_cache() {
    local force=$1
    # Data saving mode: make no network call. This returns before the day-change
    # branch below, which would otherwise clear the alert directory and refetch.
    # An explicit right-click still refreshes: suppressing a poll is the point,
    # overriding a deliberate request is not -- the same choice newsboat makes
    # for a manual reload.
    datasave_on && (( ! force )) && return 0
    local today=$(date +%Y-%m-%d)
    local refresh=$force

    if [[ ! -f "$CACHE_FILE" ]]; then
        refresh=1
    else
        local cache_day=$(head -1 "$CACHE_FILE")
        if [[ "$cache_day" != "$today" ]]; then
            refresh=1
            rm -f "$ALERT_DIR"/*
        elif (( $(date +%s) - $(stat -c %Y "$CACHE_FILE") > CACHE_MAX_AGE )); then
            refresh=1
        fi
    fi

    if (( refresh )); then
        (( force )) && notify-send -t 2000 "Calendar" "Refreshing..."
        local tmpfile=$(mktemp)
        if "$GCALCLI" agenda "$today" "$(date -d "$today + 1 day" +%Y-%m-%d)" \
            "${GCAL_CAL_ARGS[@]}" --tsv 2>"$CACHE_FILE.err" \
            > "$tmpfile"; then
            echo "$today" > "$CACHE_FILE"
            tail -n +2 "$tmpfile" | while IFS=$'\t' read -r _ start_time _ end_time title; do
                [[ -z "$start_time" || -z "$title" ]] && continue
                # Escape polybar's tag opener at the single point titles enter
                # the cache. polybar parses %{A1:cmd:} click actions in module
                # output and runs them through a shell, so an event titled
                # "%{A1:curl x|sh:}Standup%{A}" -- set by anyone who can send a
                # meeting invite -- would otherwise arm the bar with a command.
                echo "${start_time} ${end_time} ${title//%/%%}"
            done >> "$CACHE_FILE"
            if (( force )); then
                local count=$(( $(wc -l < "$CACHE_FILE") - 1 ))
                notify-send -t 2000 "Calendar" "$count event(s) today"
            fi
        else
            notify-send -t 3000 "Calendar" "Error: $(cat "$CACHE_FILE.err")"
            rm -f "$CACHE_FILE"
        fi
        rm -f "$tmpfile"
    fi
}

# Check for force-refresh flag (from click handler)
force=0
if [[ -f "$FORCE_FILE" ]]; then
    rm -f "$FORCE_FILE"
    force=1
fi

refresh_cache $force

# No cache (gcalcli failed, or data saving mode has never had one). Exiting
# silently would empty the module's output and hide it from the bar entirely, so
# while the mode is on print a neutral marker instead.
if [[ ! -f "$CACHE_FILE" ]]; then
    datasave_on && echo "$ICON_PAUSED"
    exit 0
fi

# Data saving mode holding a cache from an earlier day: showing yesterday's
# schedule as today's is worse than showing nothing.
if datasave_on && [[ "$(head -1 "$CACHE_FILE")" != "$(date +%Y-%m-%d)" ]]; then
    echo "$ICON_PAUSED"
    exit 0
fi

# No events scheduled today
event_count=$(( $(wc -l < "$CACHE_FILE") - 1 ))
if (( event_count == 0 )); then
    echo "$ICON_NORMAL No events today"
    exit 0
fi

now=$(date +%H:%M)
now_min=$(time_to_min "$now")

# Filter to non-ended events
mapfile -t events < <(
    tail -n +2 "$CACHE_FILE" | while IFS=' ' read -r st et title; do
        [[ "$et" > "$now" ]] && echo "${st} ${et} ${title}"
    done
)

# All events ended
if [[ ${#events[@]} -eq 0 ]]; then
    echo "$ICON_NORMAL No more events"
    exit 0
fi

# Parse first non-ended event
event="${events[0]}"
start_time="${event%% *}"
rest="${event#* }"
end_time="${rest%% *}"
title_part="${rest#* }"

start_min=$(time_to_min "$start_time")
diff=$((start_min - now_min))

# Full title for alerts, truncated for polybar
full_title="$title_part"
if (( ${#title_part} > MAX_TITLE_LEN )); then
    title_part="${title_part:0:$MAX_TITLE_LEN}.."
fi

# 5-minute fullscreen alert (once per meeting)
alert_flag="$ALERT_DIR/${start_time}_$(echo "$full_title" | md5sum | cut -c1-8)"
# A fullscreen alert is the one path here that takes over the whole screen, and
# while the mode is on the cache behind it stops being refreshed -- so a meeting
# cancelled hours ago could still seize the display, with the cancellation
# invisible precisely because the fetch was suppressed. Same-day is not fresh
# enough for that; hold the alert to the normal cache-age bound.
alert_ok=1
if datasave_on && (( $(date +%s) - $(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0) > CACHE_MAX_AGE )); then
    alert_ok=0
fi
if (( alert_ok && diff > 0 && diff <= ALERT_MINUTES )) && [[ ! -f "$alert_flag" ]]; then
    touch "$alert_flag"
    ~/.config/i3/scripts/fullscreen-alert "$full_title" "IN ${diff} MINUTES!" &
fi

if (( diff <= 0 )); then
    # LIVE — blink by alternating on even/odd seconds
    if (( $(date +%s) % 2 )); then
        echo "%{F$COLOR_LIVE}$ICON_LIVE ${start_time} ${title_part}%{F-}"
    else
        echo "$ICON_LIVE ${start_time} ${title_part}"
    fi
elif (( diff <= WARN_MINUTES )); then
    # WARNING — 10 min before
    echo "%{F$COLOR_WARN}$ICON_NORMAL ${start_time} ${title_part}%{F-}"
else
    # NORMAL
    echo "$ICON_NORMAL ${start_time} ${title_part}"
fi
