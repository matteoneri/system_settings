#!/bin/bash
# Rebuild the i3 session recorded by session-snapshot: layout, terminal cwds,
# and resumed agent sessions. Runs once per fresh i3 start (exec --no-startup-id).
#
# Also usable as `session-restore --plan <snapshot> <workspace>` to print the
# generated layout and terminal manifest without touching the desktop.

STATE_DIR="$HOME/.config/i3-session"
# Overridable so a restore can be rehearsed against a scratch snapshot without
# disturbing the live one.
SNAPSHOT="${I3_SESSION_SNAPSHOT:-$STATE_DIR/snapshot.json}"
SKIP_MARKER="$STATE_DIR/skip"
RESTORE_LOCK="$STATE_DIR/restore.lock"
RESTORE_DONE="/tmp/i3-session-restore-done"
LAYOUT_DIR="$STATE_DIR/layouts"
LOG="$STATE_DIR/restore.log"
SETTLE_TRIES=45
PLACE_TRIES=40
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
INSTANCE_PREFIX="i3s"

# --- layout synthesis: prune unrestored slots, renormalize, name each slot ---

# Prints {layout:[...], terminals:[...]} for one workspace, or exits non-zero.
# Slots for windows this feature does not restore are dropped and their siblings
# renormalized, so no unfillable placeholder is ever created.
plan_workspace() {
    local snapshot="$1" ws="$2" base="${3:-1}"
    jq -e --arg ws "$ws" --argjson base "$base" --arg prefix "$INSTANCE_PREFIX" '
        def prune:
            if .type == "leaf" then
                (if .restore == true then . else empty end)
            else
                ([ .nodes[]? | prune ]) as $kids
                | if ($kids | length) == 0 then empty
                  else { type: "con", layout: .layout, percent: (.percent // 0), nodes: $kids }
                  end
            end;
        def renorm:
            if .type == "con" then
                ([ .nodes[] | (.percent // 0) ] | add) as $sum
                | (.nodes | length) as $n
                | .nodes = [ .nodes[]
                    | (.percent = (if $sum > 0 then ((.percent // 0) / $sum) else (1 / $n) end))
                    | renorm ]
            else . end;
        def to_i3:
            if .type == "leaf" then
                { type: "con", percent: .percent,
                  swallows: [ { instance: ("^" + .instance + "$") } ] }
            else
                { type: "con", layout: .layout, percent: .percent,
                  nodes: [ .nodes[] | to_i3 ] }
            end;

        (.workspaces[] | select(.name == $ws)) as $w
        | ({ type: "con", layout: "splith", percent: 1, nodes: ($w.tree // []) }
           | [ prune ] | .[0] // null) as $root
        | if $root == null then { layout: [], terminals: [] }
          else
            ($root | renorm) as $r
            # paths/getpath rather than a direct walk: a leaf can sit at any
            # nesting depth, and each needs a distinct swallow criterion.
            | [ $r | paths as $p
                | (($r | getpath($p)) as $n
                   | select(($n | type) == "object" and $n.type == "leaf")
                   | $p) ] as $lp
            | reduce range(0; ($lp | length)) as $i ({ tree: $r, terms: [] };
                ($lp[$i]) as $p
                | ($prefix + "-" + (($base + $i) | tostring)) as $inst
                | .tree = (.tree | setpath($p + ["instance"]; $inst))
                | .terms = (.terms + [ ($r | getpath($p)) + { instance: $inst } ]))
            | { layout: [ .tree.nodes[] | to_i3 ],
                terminals: [ .terms[]
                  | { instance, cwd, agent, session_id, config_dir,
                      inexact: (.inexact // false) } ] }
          end' "$snapshot" 2>/dev/null
}

if [[ "$1" == "--plan" ]]; then
    if [[ ! -f "$2" ]]; then
        echo "session-restore --plan: no snapshot file at '$2'" >&2
        exit 1
    fi
    if ! jq -e . "$2" >/dev/null 2>&1; then
        echo "session-restore --plan: '$2' is not valid JSON" >&2
        exit 1
    fi
    if ! plan_workspace "$2" "$3" 1; then
        echo "session-restore --plan: no workspace '$3' in that snapshot, or nothing in it to restore" >&2
        exit 1
    fi
    exit 0
fi

# --- guards ------------------------------------------------------------------

# dunst is restarted by theme-switch during boot and can be left paused by
# dnd-toggle, so a notification alone can vanish. Every message also goes to a
# log the user can read after the fact.
report() {
    printf '%s %s\n' "$(date '+%F %T')" "$1" >> "$LOG"
    notify-send "Session restore" "$1"
}

# Handshake the watcher waits on before its first tick. It lives in /tmp, which
# is tmpfs here, so every boot starts without it. Written on every exit path,
# including the skip and no-snapshot paths — those take no lock, and without the
# handshake the next tick would replace the snapshot the skip exists to keep.
trap 'rm -f "$RESTORE_LOCK"; : > "$RESTORE_DONE"' EXIT

# One boot can opt out; the marker self-clears so the next boot restores.
if [[ -f "$SKIP_MARKER" ]]; then
    rm -f "$SKIP_MARKER"
    report "Skipped for this boot"
    exit 0
fi

# The first boot after this lands has no snapshot. Nothing to say about it.
[[ -f "$SNAPSHOT" ]] || exit 0

if ! jq -e . "$SNAPSHOT" >/dev/null 2>&1; then
    report "Snapshot is unreadable; not restoring"
    exit 1
fi

# Claim the lock before waiting, not after: the watcher starts from its own exec
# line at the same time, and during a settle wait of up to SETTLE_TRIES seconds
# an unlocked tick would replace the snapshot being restored with a capture of
# the empty boot desktop.
mkdir -p "$LAYOUT_DIR" && chmod 700 "$STATE_DIR" "$LAYOUT_DIR"
# Generated layout filenames carry a per-run slot index, so they differ between
# boots and would otherwise pile up instead of being overwritten.
find "$LAYOUT_DIR" -maxdepth 1 -name '*.json' -delete 2>/dev/null
touch "$RESTORE_LOCK"

# theme-switch restarts i3 in place about a second into boot, and ws10-layout
# steals focus to lay out the chat apps. Appending layouts through either is
# what loses placeholders, so wait them out. Break and proceed on timeout.
tries=0
while pgrep -f "i3/scripts/theme-switch" >/dev/null 2>&1 || pgrep -f "i3/scripts/ws10-layout" >/dev/null 2>&1; do
    sleep 1
    tries=$((tries + 1))
    (( tries >= SETTLE_TRIES )) && break
done

# --- helpers and value validation --------------------------------------------

# Container ids of placeholders on a workspace that no window has filled yet.
# Empty output means every slot is filled. The workspace scoping is required, not
# incidental: i3's own topdock/bottomdock areas also carry a swallows entry, so a
# tree-wide version of this query would return them and the sweep would kill the
# dock that polybar lives in.
unfilled_slots() {
    i3-msg -t get_tree 2>/dev/null | jq -r --arg ws "$1" '
        .. | objects | select(.type == "workspace" and .name == $ws)
        | [ recurse(.nodes[]?) ] | .[]
        | select(((.swallows // []) | length) > 0) | .id' 2>/dev/null
}

valid_workspace_name() { [[ -n "$1" && "$1" != *'"'* && "$1" != *';'* ]]; }
valid_session_id()     { [[ "$1" =~ $UUID_RE ]]; }
valid_cwd()            { [[ -n "$1" && "$1" == /* && -d "$1" ]]; }
valid_config_dir()     { [[ "$1" == "$HOME/.claude-fna" || "$1" == "$HOME/.claude-own" || "$1" == "$HOME/.claude" ]]; }

# --- restore -----------------------------------------------------------------

restored=0
failed=0
swept=0
next_index=1
used_sessions=" "
focused=$(jq -r '.focused_workspace // empty' "$SNAPSHOT")
# A watcher that died leaves the snapshot frozen; a days-old restore that
# looks correct is the failure to make visible.
snap_age_h=$(( ( $(date +%s) - $(stat -c %Y "$SNAPSHOT" 2>/dev/null || date +%s) ) / 3600 ))

while IFS= read -r ws; do
    if ! valid_workspace_name "$ws"; then
        report "Skipped a workspace with an unusable name"
        failed=$((failed + 1))
        continue
    fi

    plan=$(plan_workspace "$SNAPSHOT" "$ws" "$next_index")
    if [[ -z "$plan" ]]; then
        report "Could not plan workspace $ws; skipped it"
        failed=$((failed + 1))
        continue
    fi
    slot_count=$(echo "$plan" | jq '.terminals | length')
    (( slot_count == 0 )) && continue

    touch "$RESTORE_LOCK"
    layout_file="$LAYOUT_DIR/ws-$next_index.json"
    # append_layout takes a stream of top-level containers, not a JSON array.
    ( umask 077; echo "$plan" | jq -c '.layout[]' > "$layout_file" )

    # Confirm the switch landed before appending: append_layout targets whatever
    # is focused, so a failed switch would build this workspace's layout on top
    # of a different one.
    if ! i3-msg "workspace \"$ws\"" 2>&1 | rg -q '"success":true'; then
        report "Could not switch to workspace $ws; skipped it"
        failed=$((failed + 1))
        continue
    fi
    if ! i3-msg "append_layout $layout_file" 2>&1 | rg -q '"success":true'; then
        report "Could not lay out workspace $ws"
        failed=$((failed + 1))
        continue
    fi

    while IFS= read -r term; do
        inst=$(jq -r '.instance' <<< "$term")
        cwd=$(jq -r '.cwd // ""' <<< "$term")
        agent=$(jq -r '.agent // ""' <<< "$term")
        sid=$(jq -r '.session_id // ""' <<< "$term")
        cdir=$(jq -r '.config_dir // ""' <<< "$term")

        if ! valid_cwd "$cwd"; then
            report "Skipped $inst: directory is gone"
            failed=$((failed + 1))
            continue
        fi

        # The inexact fallback resolves per directory, so several panes in one
        # repository can carry the same session id. Resuming it twice would put
        # two processes in one transcript, so the first pane wins and the rest
        # come back as shells.
        if [[ -n "$sid" && "$used_sessions" == *" $sid "* ]]; then
            kitty --name "$inst" --directory "$cwd" & disown
            report "$inst: session already resumed in another pane, opened a shell"
            failed=$((failed + 1))
            restored=$((restored + 1))
            sleep 0.4
            continue
        fi
        [[ -n "$sid" ]] && used_sessions+="$sid "

        # Values are passed as separate arguments, never interpolated into a
        # command string, and the agent is the binary — not the shell wrapper,
        # which would add a permission bypass and an interactive account prompt.
        case "$agent" in
            claude)
                if valid_session_id "$sid" && valid_config_dir "$cdir"; then
                    kitty --name "$inst" --directory "$cwd" -e \
                        env "CLAUDE_CONFIG_DIR=$cdir" claude --resume "$sid" & disown
                else
                    kitty --name "$inst" --directory "$cwd" & disown
                    report "$inst: session unusable, opened a shell"
                    failed=$((failed + 1))
                fi
                ;;
            codex)
                if valid_session_id "$sid"; then
                    kitty --name "$inst" --directory "$cwd" -e codex resume "$sid" & disown
                else
                    kitty --name "$inst" --directory "$cwd" & disown
                    report "$inst: session unusable, opened a shell"
                    failed=$((failed + 1))
                fi
                ;;
            *)
                kitty --name "$inst" --directory "$cwd" & disown
                ;;
        esac
        restored=$((restored + 1))
        sleep 0.4
    done < <(echo "$plan" | jq -c '.terminals[]')

    # Wait for the slots to fill, then drop any that never did. A placeholder is
    # a real window distinguished by its non-empty swallows array, so it is
    # killed by container id rather than by a workspace-wide kill, which would
    # take the real windows with it. One query answers both questions: which
    # slots are still empty, and what to kill once waiting is over.
    tries=0
    unfilled=""
    while (( tries < PLACE_TRIES )); do
        unfilled=$(unfilled_slots "$ws")
        [[ -z "$unfilled" ]] && break
        sleep 0.5
        tries=$((tries + 1))
    done

    # Re-read rather than reusing the polled list: it is up to one interval old,
    # and a slot filled in the meantime is a real terminal now, not a placeholder.
    while IFS= read -r con_id; do
        [[ -z "$con_id" ]] && continue
        i3-msg "[con_id=$con_id] kill" >/dev/null 2>&1
        report "Workspace $ws: a terminal never appeared; removed its empty slot"
        swept=$((swept + 1))
    done <<< "$(unfilled_slots "$ws")"

    next_index=$((next_index + slot_count))
done < <(jq -r '.workspaces[].name' "$SNAPSHOT")

if [[ -n "$focused" ]] && valid_workspace_name "$focused"; then
    i3-msg "workspace \"$focused\"" >/dev/null 2>&1
fi

summary="$restored terminal(s) restored"
(( failed > 0 )) && summary+=", $failed problem(s)"
# Counted apart from failures: an empty slot is usually the downstream effect of
# a failure already counted above, so folding them together would double-report
# one bad directory as two problems.
(( swept > 0 )) && summary+=", $swept empty slot(s) removed"
report "$summary (snapshot ${snap_age_h}h old)"
