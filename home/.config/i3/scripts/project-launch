#!/bin/bash

# The projects root (PROJECTS_ROOT) follows the rules of projects_root_resolve
# in system_settings' lib/projects-root.sh. This script is installed on its own
# and cannot source that library, so the functions below repeat it; keep them
# in step. A non-empty exported PROJECTS_ROOT wins, else the last
# PROJECTS_ROOT= line of ~/.config/environment.d/50-projects-root.conf, which
# i3 on the Dell does not inherit; a leading ~, $HOME or ${HOME} expands; a
# relative path, / or a missing directory is refused.

# Print the value of FILE's last PROJECTS_ROOT= line, with surrounding
# whitespace and one pair of quotes stripped as systemd does; 1 when it has none.
_projects_root_declared() {
    local line value found=1
    [[ -r "$1" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*PROJECTS_ROOT[[:space:]]*=(.*)$ ]]; then
            value="${BASH_REMATCH[1]}"
            found=0
        fi
    done < "$1"
    (( found == 0 )) || return 1
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
    fi
    printf '%s\n' "$value"
}

# Print VALUE expanded and normalised, or print why it is refused and return 1.
# ORIGIN (exported or declared) goes into that message.
_projects_root_normalise() {
    local value="$1" origin="$2" root
    case "$value" in
        '~' | '~/'*)             value="$HOME${value:1}" ;;
        '$HOME' | '$HOME/'*)     value="$HOME${value:5}" ;;
        '${HOME}' | '${HOME}/'*) value="$HOME${value:7}" ;;
    esac
    if [[ "$value" != /* ]]; then
        echo "PROJECTS_ROOT='$value' ($origin) is not an absolute path"
        return 1
    fi
    root="$(realpath -s -m -- "$value" 2>/dev/null)"
    if [[ -z "$root" || "$root" == / ]]; then
        echo "PROJECTS_ROOT='$value' ($origin) does not name a projects folder"
        return 1
    fi
    if [[ ! -d "$root" ]]; then
        echo "PROJECTS_ROOT='$root' ($origin) is not an existing directory"
        return 1
    fi
    printf '%s\n' "$root"
}

# Set PROJECTS_ROOT to the resolved root and return 0, or set ROOT_ERROR to a
# one-line message naming the problem and the declaration file and return 1.
resolve_projects_root() {
    local file="$HOME/.config/environment.d/50-projects-root.conf" value origin result
    if [[ -n "${PROJECTS_ROOT-}" ]]; then
        value="$PROJECTS_ROOT" origin="exported"
    elif value="$(_projects_root_declared "$file")"; then
        origin="declared"
    fi
    result="PROJECTS_ROOT is not set (neither exported nor declared)"
    if [[ -n "$origin" ]] && result="$(_projects_root_normalise "$value" "$origin")"; then
        PROJECTS_ROOT="$result"
        return 0
    fi
    ROOT_ERROR="$result. Declare it in $file with a line like PROJECTS_ROOT=\${HOME}/path/to/projects (an exported PROJECTS_ROOT takes precedence over the file)."
    return 1
}

if ! resolve_projects_root; then
    echo "project-launch: $ROOT_ERROR" >&2
    notify-send "Projects root not found" "$ROOT_ERROR"
    exit 1
fi
PROJECTS_DIR="$PROJECTS_ROOT/ActiveProjects"

# Build project list: category/project for nested, just name for top-level
list_projects() {
    for entry in "$PROJECTS_DIR"/*/; do
        name=$(basename "$entry")
        if [[ "$name" == "OWN" || "$name" == "FNA" ]]; then
            for sub in "$entry"*/; do
                [ -d "$sub" ] && echo "$name/$(basename "$sub")"
            done
        else
            echo "$name"
        fi
    done
}

if [ -z "$1" ]; then
    project=$(list_projects | rofi -dmenu -p "Project" -config ~/.config/rofi/rofidmenu.rasi)
    [ -z "$project" ] && exit 0
else
    project="$1"
fi

path="$PROJECTS_DIR/$project"

if [ ! -d "$path" ]; then
    notify-send "Project not found" "$path"
    exit 1
fi

# Determine category (OWN/FNA) from project path
category="${project%%/*}"

KITTY_CONF="$HOME/.config/kitty/kitty.conf"

# Pick browser, claude config, and kitty theme based on category
if [[ "$category" == "FNA" ]]; then
    browser_cmd="firefox"
    claude_config_dir="$HOME/.claude-fna"
    kitty_theme="$HOME/.config/kitty/themes/Hachiko.conf"
else
    browser_cmd="brave"
    claude_config_dir="$HOME/.claude-own"
    kitty_theme="$HOME/.config/kitty/themes/Dayfox.conf"
fi

# Set workspace icon based on category
if [[ "$category" == "FNA" ]]; then
    ws_icon="󰔶"
else
    ws_icon="󰉛"
fi

ws_name=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused) | .name')
# Only rename plain numeric workspaces (skip 9-10 which have static icons)
if [[ "$ws_name" =~ ^[0-9]+$ ]]; then
    i3-msg "rename workspace \"$ws_name\" to \"$ws_name:$ws_icon\""
fi

# Navigate to workspace level so a second project creates a new column
i3-msg 'focus parent; focus parent; focus parent; focus parent; split h'

# Layout target:
#   tabbed[yazi, browser]
#   ─────────────────────
#          claude
#
# Two projects side by side:
#   tabbed[yazi1, browser1] || tabbed[yazi2, browser2]
#   ────────────────────────||────────────────────────
#          claude1           ||         claude2

# 1. Open yazi (creates new column if workspace already has windows)
# The main config must be passed explicitly: kitty skips ~/.config/kitty/kitty.conf
# entirely once --config is given, which would leave these windows with no
# remote-control socket and make them invisible to session-snapshot.
kitty --config "$KITTY_CONF" --config "$kitty_theme" --directory "$path" -e yazi &
sleep 1

# 2. Split vertically: claude will go below yazi. kitty runs it without a
# shell, so the resolved root is handed over here with the config dir.
i3-msg 'splitv'
kitty --config "$KITTY_CONF" --config "$kitty_theme" --directory "$path" -e env CLAUDE_CONFIG_DIR="$claude_config_dir" PROJECTS_ROOT="$PROJECTS_ROOT" claude &
sleep 1

# 3. Focus back up to yazi, split horizontally for the browser tab
i3-msg 'focus up; splith'
$browser_cmd --new-window "https://claude.ai" &
sleep 1

# 4. Make yazi+browser container tabbed
i3-msg 'layout tabbed'

# Obsidian if vault exists
if [ -d "$path/docs/.obsidian" ]; then
    obsidian "$path/docs" &
fi
